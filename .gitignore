# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/

# PyPI long description — generated at build time by scripts/gen_pypi_readme.py
# (make build): README.md with relative links rewritten to version-tagged URLs.
README.pypi.md

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS / editors
.DS_Store
.idea/
.vscode/

# Bundled default fonts — fetched at build time (make fonts / scripts/fetch_fonts.py),
# not committed. See puikit/fonts/README.md.
puikit/fonts/*.ttf
puikit/fonts/*.otf
puikit/fonts/OFL.txt
puikit/fonts/OFL-CJK.txt
